YOLO_MODEL=yolo11s.pt
CONFIDENCE_THRESHOLD=0.35
SPRING_CONGESTION_URL=http://127.0.0.1:8080/api/ai/congestion
SPRING_API_KEY=shiftops-ai-secret
SEND_TO_SPRING=false
INFERENCE_WORKERS=2
MAX_PENDING_FRAMES=20
SENDER_QUEUE_MAX_SIZE=100
SENDER_QUEUE_DB=logs/sender_queue.sqlite3
SENDER_POLL_INTERVAL_SEC=1
INCLUDE_AGGREGATE_SAMPLES=true
INCLUDE_CAMERA_ANNOTATED_IMAGE=false
INCLUDE_IMAGE_ANNOTATED_IMAGE=true
SPRING_SEND_RETRY=3
SPRING_SEND_TIMEOUT_SEC=3
FAILED_PAYLOAD_LOG=logs/failed_payloads.log
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SEC=20
